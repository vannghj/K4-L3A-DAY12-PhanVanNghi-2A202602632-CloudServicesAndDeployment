# TODO (CP2): file này quyết định thứ KHÔNG được copy vào image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.
# Bổ sung đủ các mục còn thiếu — xem tests/test_cp2.py để biết yêu cầu.

# Secret — không bao giờ được nằm trong image
.env
.env.*
**/.env
*.pem
*.key

# Git
.git
.gitignore
.github

# Môi trường ảo và file sinh ra khi chạy Python
.venv
venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache

# Không cần lúc chạy service
tests
screenshots
nginx
solution
*.md
docker-compose.yml
Dockerfile
.dockerignore

# OS / editor
**/.DS_Store
.idea
.vscode
